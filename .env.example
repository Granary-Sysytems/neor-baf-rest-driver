HOST=127.0.0.1
PORT=8787
DEVICE_SERIAL=DK50P30000422
# Optional USB iSerial if it differs from the label serial (observed: SN0001)
DEVICE_USB_SERIAL=SN0001
# Optional AVFoundation name substring (Ukrainian macOS often shows "USB-камера")
DEVICE_NAME_MATCH=USB
FFMPEG_PATH=ffmpeg
# 2592x1944 is listed by the device but hangs; 2560x1440 is the practical max.
CAPTURE_DEFAULT_WIDTH=2560
CAPTURE_DEFAULT_HEIGHT=1440
CAPTURE_FRAMERATE=10
CAPTURE_TIMEOUT_MS=30000
